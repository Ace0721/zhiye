{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhiye",
  "version": "0.3.0",
  "identifier": "io.zhiye.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Zhiye · 知页", "width": 1180, "height": 840, "minWidth": 360, "minHeight": 620, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "externalBin": ["binaries/zhiye-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
